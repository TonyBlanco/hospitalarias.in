---
import Base from '@/layouts/Base.astro';
import NewsArticle from '@/components/NewsArticle.astro';
import { crumbPath, newsArticleSchema } from '@/utils/seo';
import { mediaPath } from '@/utils/media';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const news = await getCollection('news');
  return news
    .filter((item) => item.id.startsWith('es/'))
    .map((entry) => ({
      params: { slug: entry.id.slice(3) },
      props: { entry },
    }));
}

const { entry } = Astro.props;
const canonical = new URL(Astro.url.pathname, 'https://hospitalarias.in').toString();
const ogImage = new URL(mediaPath(entry.data.image), 'https://hospitalarias.in').toString();
---

<Base title={entry.data.title} description={entry.data.description} locale="es" pageId="news" crumbs={[...crumbPath('es', 'news'), { label: entry.data.title }]} ogType="article" ogImage={ogImage} publishedTime={entry.data.date.toISOString()} extraSchema={newsArticleSchema(entry, 'es', canonical)}>
  <NewsArticle entry={entry} locale="es" />
</Base>
