---
import Base from '@/layouts/Base.astro';
import NewsArticle from '@/components/NewsArticle.astro';
import { crumbPath } from '@/utils/seo';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const news = await getCollection('news');
  return news
    .filter((item) => item.id.startsWith('es/'))
    .map((entry) => ({
      params: { slug: entry.id.slice(3) },
      props: { entry },
    }));
}

const { entry } = Astro.props;
---

<Base title={entry.data.title} description={entry.data.description} locale="es" pageId="news" crumbs={[...crumbPath('es', 'news'), { label: entry.data.title }]}>
  <NewsArticle entry={entry} locale="es" />
</Base>
