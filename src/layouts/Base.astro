---
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import '@/styles/global.css';
import type { Locale, PageId } from '@/data/pages';
import { alternateLinks, crumbPath, type Crumb } from '@/utils/seo';
import { t } from '@/data/i18n';

type Props = {
  title: string;
  description: string;
  locale: Locale;
  pageId: PageId;
  crumbs?: Crumb[];
  ogType?: 'website' | 'article';
  ogImage?: string;
  publishedTime?: string;
  extraSchema?: Record<string, unknown>;
};

const { title, description, locale, pageId, crumbs, ogType, ogImage, publishedTime, extraSchema } = Astro.props;
const canonical = new URL(Astro.url.pathname, 'https://hospitalarias.in').toString();
const alternates = alternateLinks(pageId);
const ogLocaleMap: Record<Locale, string> = { en: 'en_US', es: 'es_ES', hi: 'hi_IN', ml: 'ml_IN' };
const ogImageUrl = ogImage ?? 'https://hospitalarias.in/images/2025/09/HOSPITALLER-FAMILY-scaled.jpg';
// Injected at build time from repo secrets — empty means "not configured, emit nothing".
const gaId = import.meta.env.PUBLIC_GA_ID ?? '';
const gscVerification = import.meta.env.PUBLIC_GSC_VERIFICATION ?? '';
const trail = crumbs ?? crumbPath(locale, pageId);
const schema = {
  '@context': 'https://schema.org',
  '@type': 'NGO',
  name: 'Benedict Menni Psycho-Social Rehabilitation Centre',
  url: 'https://hospitalarias.in',
  description,
};
const breadcrumbSchema = trail.length > 1
  ? {
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: trail.map((c, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        name: c.label,
        item: c.href ? `https://hospitalarias.in${c.href}` : canonical,
      })),
    }
  : null;
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/logo.svg" />
    <link rel="apple-touch-icon" href="/logo.svg" />
    <title>{title} | Hospitalarias</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {alternates.map((alternate) => <link rel="alternate" hreflang={alternate.lang} href={alternate.href} />)}
    <meta property="og:type" content={ogType ?? 'website'} />
    <meta property="og:title" content={`${title} | Hospitalarias`} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:locale" content={ogLocaleMap[locale]} />
    {alternates.filter((a) => a.lang !== 'x-default').map((a) => <meta property="og:locale:alternate" content={ogLocaleMap[a.lang as Locale]} />)}
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="alternate" type="application/rss+xml" title="News — Benedict Menni Centre" href="/feed.xml" />
    {gscVerification && <meta name="google-site-verification" content={gscVerification} />}
    {gaId && (
      <>
        <script async src={`https://www.googletagmanager.com/gtag/js?id=${gaId}`} />
        <script is:inline define:vars={{ gaId }}>
          window.dataLayer = window.dataLayer || [];
          function gtag() { dataLayer.push(arguments); }
          gtag('js', new Date());
          gtag('config', gaId, { anonymize_ip: true });
        </script>
      </>
    )}
    <script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />
    {breadcrumbSchema && <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />}
    {extraSchema && <script is:inline type="application/ld+json" set:html={JSON.stringify(extraSchema)} />}
  </head>
  <body>
    <a class="skip-link" href="#main">{t(locale, 'skipToContent')}</a>
    <script is:inline>
      try { navigator.sendBeacon('/track.php?p=' + encodeURIComponent(location.pathname)); } catch (e) {}
    </script>
    <Header locale={locale} pageId={pageId} />
    <main id="main">
      {trail.length > 1 && (
        <nav class="breadcrumbs" aria-label="Breadcrumb">
          <div class="container">
            <ol>
              {trail.map((c, i) => (
                <li>
                  {i < trail.length - 1 && c.href
                    ? <a href={c.href}>{c.label}</a>
                    : <span aria-current="page">{c.label}</span>}
                </li>
              ))}
            </ol>
          </div>
        </nav>
      )}
      <slot />
    </main>
    <Footer locale={locale} />
  </body>
</html>
