---
import { type Locale, routes } from '@/data/pages';
import { t } from '@/data/i18n';
import { mediaPath } from '@/utils/media';
import { render, type CollectionEntry } from 'astro:content';

type Props = { entry: CollectionEntry<'news'>; locale: Locale };
const { entry, locale } = Astro.props;
const { Content } = await render(entry);

const localeMap: Record<Locale, string> = { en: 'en-GB', hi: 'hi-IN', ml: 'ml-IN', es: 'es-ES' };
const dateStr = entry.data.date.toLocaleDateString(localeMap[locale] ?? 'en-GB', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

const video = entry.data.video ?? '';
const yt = video.match(/(?:youtube\.com\/(?:watch\?[^#]*v=|shorts\/|embed\/)|youtu\.be\/)([\w-]{6,})/);
const vm = video.match(/vimeo\.com\/(?:video\/)?(\d+)/);
const videoEmbed = yt
  ? `https://www.youtube-nocookie.com/embed/${yt[1]}`
  : vm
    ? `https://player.vimeo.com/video/${vm[1]}`
    : null;
const videoFile = video.startsWith('/') ? mediaPath(video) : null;
---

<section class="section alt">
  <div class="container">
    <p class="eyebrow">{entry.data.category}</p>
    <h1>{entry.data.title}</h1>
    <p class="lead"><time datetime={entry.data.date.toISOString()}>{dateStr}</time></p>
  </div>
</section>

<section class="section">
  <div class="container prose">
    <img src={mediaPath(entry.data.image)} alt={entry.data.imageAlt} />
    {videoFile && <video class="article-video" src={videoFile} controls playsinline preload="metadata" />}
    {videoEmbed && (
      <div class="video-embed">
        <iframe src={videoEmbed} title={entry.data.title} loading="lazy" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen />
      </div>
    )}
    <Content />
    <p><a href={routes[locale].news}>{t(locale, 'backToNews')}</a></p>
  </div>
</section>
